@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep: <https://example.org/kr/real-estate-policy/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kr/real-estate-policy/ontology> a owl:Ontology ;
    rdfs:label "부동산 정책 온톨로지: 정제 CSV 기반 재설계"@ko ;
    rdfs:comment "원문 262건으로부터 재설계한 클래스와 관계 정의. 검증되지 않은 정책-법령/후속 관계를 확정 사실로 전제하지 않음."@ko .

rep:PolicyPackage a owl:Class ;
    rdfs:label "종합대책·대책 패키지"@ko ;
    rdfs:comment "여러 세부조치를 묶어서 발표하는 대책 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 주의: 제목의 대책 키워드는 분류 후보일 뿐이다"@ko ;
    rdfs:subClassOf rep:PolicyInitiative .

rep:abstractRaw a owl:DatatypeProperty ;
    rdfs:label "정제된 본문"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 해당 원천 필드는 정제되었지만 마크업 잔재 가능"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:announcedBy a owl:ObjectProperty ;
    rdfs:label "정책 발표기관"@ko ;
    rdfs:comment "상위 정책을 발표한 조직 / 원천: PUBLISHER·POLICY_CONTEXT_CLEAN / 검증: 출처 기관과 발표기관 구분"@ko ;
    rdfs:domain rep:PolicyInitiative ;
    rdfs:range rep:Organization .

rep:announcedDate a owl:DatatypeProperty ;
    rdfs:label "정책 발표일"@ko ;
    rdfs:comment "원천: REG_DATE·본문 / 원칙: 등록일과 구분해 검증"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range xsd:date .

rep:appliesInArea a owl:ObjectProperty ;
    rdfs:label "적용 지역"@ko ;
    rdfs:comment "해당 정책이 적용되는 지역 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 명시적 지역 확인"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:GeographicArea .

rep:appliesToHousingType a owl:ObjectProperty ;
    rdfs:label "주택 유형 적용"@ko ;
    rdfs:comment "세부정책이 적용되는 주택 유형 / 원천: ABSTRACT_CLEAN / 검증: 대상 유형 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:HousingType .

rep:areaName a owl:DatatypeProperty ;
    rdfs:label "지역 명칭"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 시기별 행정구역 명칭 유지"@ko ;
    rdfs:domain rep:GeographicArea ;
    rdfs:range xsd:string .

rep:changeSummary a owl:DatatypeProperty ;
    rdfs:label "변경 요약"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 원문을 근거로 생성"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range xsd:string .

rep:claimInDocument a owl:ObjectProperty ;
    rdfs:label "관계가 나온 문서"@ko ;
    rdfs:comment "관계 진술을 추출한 문서 / 원천: ID·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 원천 ID 보존"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range rep:SourceDocument .

rep:claimObject a owl:ObjectProperty ;
    rdfs:label "관계 목적어"@ko ;
    rdfs:comment "근거 기반 관계 진술의 목적어 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 참조 ID 필요"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range owl:Thing .

rep:claimPredicate a owl:ObjectProperty ;
    rdfs:label "관계 술어"@ko ;
    rdfs:comment "근거 기반 관계 진술의 관계 속성 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 스키마 속성만 사용"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range rdf:Property .

rep:claimSubject a owl:ObjectProperty ;
    rdfs:label "관계 주어"@ko ;
    rdfs:comment "근거 기반 관계 진술의 주어 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 참조 ID 필요"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range owl:Thing .

rep:claimSupportedBy a owl:ObjectProperty ;
    rdfs:label "관계 근거"@ko ;
    rdfs:comment "관계 진술을 뒷받침하는 구절 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 근거 필수"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range rep:EvidenceSnippet .

rep:conditionText a owl:DatatypeProperty ;
    rdfs:label "지원·규제 조건 문구"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 금액·비율·기준시점 함께 보존"@ko ;
    rdfs:domain rep:EligibilityRule ;
    rdfs:range xsd:string .

rep:contextRaw a owl:DatatypeProperty ;
    rdfs:label "정제된 배경 설명"@ko ;
    rdfs:comment "원천: POLICY_CONTEXT_CLEAN / 원칙: 정책 목표·후속 관계 근거 가능"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:describesPolicy a owl:ObjectProperty ;
    rdfs:label "정책을 설명"@ko ;
    rdfs:comment "문서가 정책 개체를 기술한다 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 동일 개체 병합 검증"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:Policy .

rep:documentTitle a owl:DatatypeProperty ;
    rdfs:label "문서 제목"@ko ;
    rdfs:comment "원천: TITLE_CLEAN / 원칙: 원문 표기 보존"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:documentTypeHint a owl:DatatypeProperty ;
    rdfs:label "문서 유형 후보"@ko ;
    rdfs:comment "원천: TITLE_CLEAN / 원칙: 제목만으로 확정하지 않음"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:eventAffectsLegalNorm a owl:ObjectProperty ;
    rdfs:label "법령 영향 사건"@ko ;
    rdfs:comment "변경 사건이 제정·개정·폐지 등을 일으킨 법규범 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 검증: 법적 단계 확인"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range rep:LegalNorm .

rep:eventAffectsPolicy a owl:ObjectProperty ;
    rdfs:label "정책 영향 사건"@ko ;
    rdfs:comment "변경 사건이 영향을 미친 정책 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 검증: 정책 일치 확인"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range rep:Policy .

rep:eventDate a owl:DatatypeProperty ;
    rdfs:label "사건 발생일"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 원천 등록일과 별도로 추출"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range xsd:date .

rep:eventIntroducesLegalVersion a owl:ObjectProperty ;
    rdfs:label "새 법령 버전 생성"@ko ;
    rdfs:comment "법령 사건이 신규 시행버전을 생성한다 / 원천: ABSTRACT_CLEAN / 검증: 정식 법령 연혁 대조"@ko ;
    rdfs:domain rep:LegalEvent ;
    rdfs:range rep:LegalVersion .

rep:eventIntroducesPolicyVersion a owl:ObjectProperty ;
    rdfs:label "새 정책 버전 생성"@ko ;
    rdfs:comment "정책 사건이 신규 버전의 변경을 일으킨다 / 원천: ABSTRACT_CLEAN / 검증: 원문 변경 전후 확인"@ko ;
    rdfs:domain rep:PolicyEvent ;
    rdfs:range rep:PolicyVersion .

rep:eventKind a owl:DatatypeProperty ;
    rdfs:label "사건 유형"@ko ;
    rdfs:comment "원천: TITLE_CLEAN·ABSTRACT_CLEAN / 원칙: announced, proposed, passed, promulgated, effective, amended, supplemented, repealed"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range xsd:string .

rep:evidenceCharEnd a owl:DatatypeProperty ;
    rdfs:label "근거 끝 위치"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 끝 오프셋은 미포함"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range xsd:integer .

rep:evidenceCharStart a owl:DatatypeProperty ;
    rdfs:label "근거 시작 위치"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 0부터 시작하는 문자 오프셋"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range xsd:integer .

rep:evidenceInSection a owl:ObjectProperty ;
    rdfs:label "근거가 나온 절"@ko ;
    rdfs:comment "근거 구절의 위치인 문서 절 / 원천: ABSTRACT_CLEAN / 검증: 절 인덱스 확인"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range rep:DocumentSection .

rep:evidenceSourceColumn a owl:DatatypeProperty ;
    rdfs:label "근거 출처 필드"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 허용값: ABSTRACT_CLEAN 또는 POLICY_CONTEXT_CLEAN"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range xsd:string .

rep:evidenceText a owl:DatatypeProperty ;
    rdfs:label "근거 구절"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 원문 문구 보존"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range xsd:string .

rep:extractionMethod a owl:DatatypeProperty ;
    rdfs:label "추출 방법"@ko ;
    rdfs:comment "원천: 추출 파이프라인 / 원칙: rule, llm, manual 등"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range xsd:string .

rep:followsUpOn a owl:ObjectProperty ;
    rdfs:label "선행대책의 후속"@ko ;
    rdfs:comment "정책 이니셔티브가 선행 정책에 이어진다 / 원천: TITLE_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 명시적 후속 연결 확인"@ko ;
    rdfs:domain rep:PolicyInitiative ;
    rdfs:range rep:PolicyInitiative .

rep:goalDescription a owl:DatatypeProperty ;
    rdfs:label "목표 문구"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 목표/성과 혼동 방지"@ko ;
    rdfs:domain rep:PolicyGoal ;
    rdfs:range xsd:string .

rep:hasEligibilityRule a owl:ObjectProperty ;
    rdfs:label "지원요건 포함"@ko ;
    rdfs:comment "정책 버전이 해당 조건을 갖는다 / 원천: ABSTRACT_CLEAN / 검증: 해당 버전 확인"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range rep:EligibilityRule .

rep:hasLegalBasis a owl:ObjectProperty ;
    rdfs:label "법적 근거"@ko ;
    rdfs:comment "정책의 성립·추진에 근거로 작용하는 법규범 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 법령명 언급만으로 확정 금지"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:LegalNorm .

rep:hasQuantitativeTarget a owl:ObjectProperty ;
    rdfs:label "정량 목표 보유"@ko ;
    rdfs:comment "정책이 수치화된 목표를 갖는다 / 원천: ABSTRACT_CLEAN / 검증: 계획값과 실적 구분"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:QuantitativeTarget .

rep:hasSubMeasure a owl:ObjectProperty ;
    rdfs:label "하위 세부조치"@ko ;
    rdfs:comment "세부정책이 하위 실행항목을 포함한다 / 원천: ABSTRACT_CLEAN / 검증: 명시적 계층 여부 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:PolicyMeasure .

rep:housingTypeName a owl:DatatypeProperty ;
    rdfs:label "주택 유형 명칭"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 예: 공공임대주택"@ko ;
    rdfs:domain rep:HousingType ;
    rdfs:range xsd:string .

rep:implementedBy a owl:ObjectProperty ;
    rdfs:label "정책 집행기관"@ko ;
    rdfs:comment "세부정책의 이행·집행 주체 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 직접 언급 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:Organization .

rep:implementedViaNorm a owl:ObjectProperty ;
    rdfs:label "법규범을 통한 집행"@ko ;
    rdfs:comment "세부정책 집행에 사용되는 법령·규정 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 집행 관련 근거 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:LegalNorm .

rep:inPolicyTopic a owl:ObjectProperty ;
    rdfs:label "정책분야 분류"@ko ;
    rdfs:comment "정책이 속하는 주제를 나타낸다 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 검증: 태그 후보"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:PolicyTopic .

rep:instrumentName a owl:DatatypeProperty ;
    rdfs:label "정책수단 명칭"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 정책 메커니즘"@ko ;
    rdfs:domain rep:PolicyInstrument ;
    rdfs:range xsd:string .

rep:lawExternalId a owl:DatatypeProperty ;
    rdfs:label "법령 외부 식별자"@ko ;
    rdfs:comment "원천: 외부 법령정보 / 원칙: CSV에 직접 없음"@ko ;
    rdfs:domain rep:LegalInstrument ;
    rdfs:range xsd:string .

rep:legalEffectiveFrom a owl:DatatypeProperty ;
    rdfs:label "법령 시행 시작일"@ko ;
    rdfs:comment "원천: 본문·외부 법령정보 / 원칙: 공포일과 구별"@ko ;
    rdfs:domain rep:LegalVersion ;
    rdfs:range xsd:date .

rep:legalEffectiveUntil a owl:DatatypeProperty ;
    rdfs:label "법령 시행 종료일"@ko ;
    rdfs:comment "원천: 외부 법령정보 / 원칙: 현재 CSV로 확정 불가"@ko ;
    rdfs:domain rep:LegalVersion ;
    rdfs:range xsd:date .

rep:legalName a owl:DatatypeProperty ;
    rdfs:label "법령명"@ko ;
    rdfs:comment "원천: TITLE_CLEAN·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 법령명 표준화 필요"@ko ;
    rdfs:domain rep:LegalNorm ;
    rdfs:range xsd:string .

rep:legalProvisionNumber a owl:DatatypeProperty ;
    rdfs:label "조항 번호"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 예: 제5조, 제10조제2항"@ko ;
    rdfs:domain rep:LegalProvision ;
    rdfs:range xsd:string .

rep:mentionsLegalNorm a owl:ObjectProperty ;
    rdfs:label "법규범 언급"@ko ;
    rdfs:comment "법령이나 조항의 명칭을 본문에서 언급한다 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 문구 확인"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:LegalNorm .

rep:metricName a owl:DatatypeProperty ;
    rdfs:label "정량 목표 지표"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 주택공급량·주택보급률 등"@ko ;
    rdfs:domain rep:QuantitativeTarget ;
    rdfs:range xsd:string .

rep:metricTargetYear a owl:DatatypeProperty ;
    rdfs:label "정량 목표 대상 연도"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 발표연도와 구분"@ko ;
    rdfs:domain rep:QuantitativeTarget ;
    rdfs:range xsd:gYear .

rep:metricUnit a owl:DatatypeProperty ;
    rdfs:label "정량 목표 단위"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 호, %, 원, ㎡ 등"@ko ;
    rdfs:domain rep:QuantitativeTarget ;
    rdfs:range xsd:string .

rep:metricValue a owl:DatatypeProperty ;
    rdfs:label "정량 목표 값"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 단위와 목표연도 동반"@ko ;
    rdfs:domain rep:QuantitativeTarget ;
    rdfs:range xsd:decimal .

rep:metricValueKind a owl:DatatypeProperty ;
    rdfs:label "정량 목표·실적 구분"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: target, actual, baseline, estimate"@ko ;
    rdfs:domain rep:QuantitativeTarget ;
    rdfs:range xsd:string .

rep:newCondition a owl:DatatypeProperty ;
    rdfs:label "변경 후 요건"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 개선·변경 등 명시시 추출"@ko ;
    rdfs:domain rep:EligibilityRule ;
    rdfs:range xsd:string .

rep:nextLegalVersion a owl:ObjectProperty ;
    rdfs:label "후속 법령 버전"@ko ;
    rdfs:comment "같은 법령의 다음 시행버전 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 외부 연혁 대조"@ko ;
    rdfs:domain rep:LegalVersion ;
    rdfs:range rep:LegalVersion .

rep:nextPolicyVersion a owl:ObjectProperty ;
    rdfs:label "후속 정책 버전"@ko ;
    rdfs:comment "같은 정책의 시간상 다음 버전 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 날짜·변경 전후 확인"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range rep:PolicyVersion .

rep:organizationName a owl:DatatypeProperty ;
    rdfs:label "기관명"@ko ;
    rdfs:comment "원천: PUBLISHER·본문 / 원칙: 표준 기관명 정규화"@ko ;
    rdfs:domain rep:Organization ;
    rdfs:range xsd:string .

rep:organizationUnitRaw a owl:DatatypeProperty ;
    rdfs:label "기관 소속부서"@ko ;
    rdfs:comment "원천: PUBLISHER / 원칙: 원래 문자열도 보존"@ko ;
    rdfs:domain rep:Organization ;
    rdfs:range xsd:string .

rep:policyName a owl:DatatypeProperty ;
    rdfs:label "정책명"@ko ;
    rdfs:comment "원천: TITLE_CLEAN·ABSTRACT_CLEAN / 원칙: 표준화된 정책 식별 이름"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range xsd:string .

rep:policyNameVariant a owl:DatatypeProperty ;
    rdfs:label "정책 이명"@ko ;
    rdfs:comment "원천: TITLE_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 동일명 판정은 별도 검증"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range xsd:string .

rep:policyVersionLabel a owl:DatatypeProperty ;
    rdfs:label "정책 버전 표기"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 예: 최초·개정·완화"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range xsd:string .

rep:previousCondition a owl:DatatypeProperty ;
    rdfs:label "변경 전 요건"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 현행·종전 등 명시시 추출"@ko ;
    rdfs:domain rep:EligibilityRule ;
    rdfs:range xsd:string .

rep:publishedBy a owl:ObjectProperty ;
    rdfs:label "문서 발행기관"@ko ;
    rdfs:comment "문서의 발행기관 또는 부서 / 원천: PUBLISHER / 검증: 기관 정규화 필요"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:Organization .

rep:publisherRaw a owl:DatatypeProperty ;
    rdfs:label "원천 발행기관 문자열"@ko ;
    rdfs:comment "원천: PUBLISHER / 원칙: 조직 개체 매칭 전 원문 보존"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:pursuesGoal a owl:ObjectProperty ;
    rdfs:label "목표 추구"@ko ;
    rdfs:comment "정책이 해당 목표를 지향한다 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 목표 표현 확인"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:PolicyGoal .

rep:registrationDate a owl:DatatypeProperty ;
    rdfs:label "등록·기록일"@ko ;
    rdfs:comment "원천: REG_DATE / 원칙: 정책 시행일과 다름"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:date .

rep:relationConfidence a owl:DatatypeProperty ;
    rdfs:label "관계 신뢰도"@ko ;
    rdfs:comment "원천: 추출 결과 / 원칙: 0~1; 자동 신뢰도는 정답 확률이 아님"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range xsd:decimal .

rep:requiresLegalChange a owl:ObjectProperty ;
    rdfs:label "법령 변경 필요"@ko ;
    rdfs:comment "정책 이행에 추가 제정·개정이 필요하다 / 원천: ABSTRACT_CLEAN / 검증: 예정과 확정 구분"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:LegalNorm .

rep:reviewNote a owl:DatatypeProperty ;
    rdfs:label "검토 메모"@ko ;
    rdfs:comment "원천: 검토 기록 / 원칙: 확정·보류 이유"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range xsd:string .

rep:reviewedAt a owl:DatatypeProperty ;
    rdfs:label "검토 일시"@ko ;
    rdfs:comment "원천: 검토 기록 / 원칙: 검토 로그"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range xsd:dateTime .

rep:revisesPlan a owl:ObjectProperty ;
    rdfs:label "기존 계획 수정"@ko ;
    rdfs:comment "정책계획이 기존 계획을 수정한다 / 원천: TITLE_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 동일계획 여부 확인"@ko ;
    rdfs:domain rep:PolicyPlan ;
    rdfs:range rep:PolicyPlan .

rep:sectionOrder a owl:DatatypeProperty ;
    rdfs:label "절 등장 순서"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 원문 순서"@ko ;
    rdfs:domain rep:DocumentSection ;
    rdfs:range xsd:integer .

rep:sectionPath a owl:DatatypeProperty ;
    rdfs:label "절 계층 경로"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 예: 1/1)/- ; 레벨 표현"@ko ;
    rdfs:domain rep:DocumentSection ;
    rdfs:range xsd:string .

rep:sectionText a owl:DatatypeProperty ;
    rdfs:label "절 본문"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 숫자·법령·날짜 유지"@ko ;
    rdfs:domain rep:DocumentSection ;
    rdfs:range xsd:string .

rep:sectionTitle a owl:DatatypeProperty ;
    rdfs:label "절 제목"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 상위 절과 구분"@ko ;
    rdfs:domain rep:DocumentSection ;
    rdfs:range xsd:string .

rep:sourceFileName a owl:DatatypeProperty ;
    rdfs:label "원천 파일명"@ko ;
    rdfs:comment "원천: 파일 메타데이터 / 원칙: CSV 파일과 연결"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:sourceId a owl:DatatypeProperty ;
    rdfs:label "원천 문서 ID"@ko ;
    rdfs:comment "원천: ID / 원칙: 고유 식별자, leading zero 보존"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:string .

rep:sourceRowNumber a owl:DatatypeProperty ;
    rdfs:label "원천 행 번호"@ko ;
    rdfs:comment "원천: ID / 원칙: 헤더 이후 1부터 시작"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range xsd:integer .

rep:supersedes a owl:ObjectProperty ;
    rdfs:label "선행대책 대체"@ko ;
    rdfs:comment "이전 정책을 전체 또는 일부 대체한다 / 원천: POLICY_CONTEXT_CLEAN·ABSTRACT_CLEAN / 검증: 자동 단정 금지"@ko ;
    rdfs:domain rep:PolicyInitiative ;
    rdfs:range rep:PolicyInitiative .

rep:supplements a owl:ObjectProperty ;
    rdfs:label "선행대책 보완"@ko ;
    rdfs:comment "정책 이니셔티브가 선행 정책을 보완한다 / 원천: POLICY_CONTEXT_CLEAN·ABSTRACT_CLEAN / 검증: 후속과 보완은 다르다"@ko ;
    rdfs:domain rep:PolicyInitiative ;
    rdfs:range rep:PolicyInitiative .

rep:targetGroupName a owl:DatatypeProperty ;
    rdfs:label "대상 집단 명칭"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN / 원칙: 예: 무주택자, 청년"@ko ;
    rdfs:domain rep:TargetGroup ;
    rdfs:range xsd:string .

rep:targetsGroup a owl:ObjectProperty ;
    rdfs:label "정책 대상"@ko ;
    rdfs:comment "세부정책이 적용되는 사람·집단 / 원천: ABSTRACT_CLEAN / 검증: 대상 조건 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:TargetGroup .

rep:topicName a owl:DatatypeProperty ;
    rdfs:label "정책분야 명칭"@ko ;
    rdfs:comment "원천: TITLE_CLEAN·ABSTRACT_CLEAN / 원칙: 통제 분류체계 권장"@ko ;
    rdfs:domain rep:PolicyTopic ;
    rdfs:range xsd:string .

rep:usesInstrument a owl:ObjectProperty ;
    rdfs:label "정책수단 사용"@ko ;
    rdfs:comment "세부정책이 사용하는 규제·지원 수단 / 원천: ABSTRACT_CLEAN / 검증: 명시적 수단 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:PolicyInstrument .

rep:validFrom a owl:DatatypeProperty ;
    rdfs:label "효력 시작일"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 미상은 누락"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range xsd:date .

rep:validUntil a owl:DatatypeProperty ;
    rdfs:label "효력 종료일"@ko ;
    rdfs:comment "원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 원칙: 종료일 경계값 정의 필요"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range xsd:date .

rep:validationStatus a owl:DatatypeProperty ;
    rdfs:label "검증 상태"@ko ;
    rdfs:comment "원천: 수동/자동 검토 / 원칙: candidate, verified, rejected, needs_external_check"@ko ;
    rdfs:domain rep:RelationClaim ;
    rdfs:range xsd:string .

rep:LegalEvent a owl:Class ;
    rdfs:label "법령 변경 사건"@ko ;
    rdfs:comment "제정·공포·개정·시행·폐지 법적 사건 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 발의·통과·공포·시행을 별도 단계로 구분"@ko ;
    rdfs:subClassOf rep:ChangeEvent .

rep:PolicyEvent a owl:Class ;
    rdfs:label "정책 변경 사건"@ko ;
    rdfs:comment "정책 발표·보완·수정·종료 사건 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 변경 전후 상태 및 근거 문서 연결"@ko ;
    rdfs:subClassOf rep:ChangeEvent .

rep:containsEvidence a owl:ObjectProperty ;
    rdfs:label "근거 구절 보유"@ko ;
    rdfs:comment "원천 문서에 해당 근거 구절이 들어 있다 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 문장 위치 확인"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:EvidenceSnippet ;
    owl:inverseOf rep:evidenceInDocument .

rep:evidenceInDocument a owl:ObjectProperty ;
    rdfs:label "근거가 나온 문서"@ko ;
    rdfs:comment "근거 구절이 나온 원천 문서 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 원천 경로 확인"@ko ;
    rdfs:domain rep:EvidenceSnippet ;
    rdfs:range rep:SourceDocument ;
    owl:inverseOf rep:containsEvidence .

rep:hasLegalVersion a owl:ObjectProperty ;
    rdfs:label "법령 버전 포함"@ko ;
    rdfs:comment "법령의 시점별 버전을 갖는다 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 외부 연혁 대조"@ko ;
    rdfs:domain rep:LegalInstrument ;
    rdfs:range rep:LegalVersion ;
    owl:inverseOf rep:versionOfLaw .

rep:hasMeasure a owl:ObjectProperty ;
    rdfs:label "세부정책 포함"@ko ;
    rdfs:comment "상위 대책·계획에 세부정책이 포함된다 / 원천: ABSTRACT_CLEAN / 검증: 계층 문장 확인"@ko ;
    rdfs:domain rep:PolicyInitiative ;
    rdfs:range rep:PolicyMeasure ;
    owl:inverseOf rep:measureOf .

rep:hasPolicyVersion a owl:ObjectProperty ;
    rdfs:label "정책 버전 포함"@ko ;
    rdfs:comment "정책의 시점별 버전을 포함한다 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 시점 증거 확인"@ko ;
    rdfs:domain rep:Policy ;
    rdfs:range rep:PolicyVersion ;
    owl:inverseOf rep:versionOfPolicy .

rep:hasProvision a owl:ObjectProperty ;
    rdfs:label "법령 조항 포함"@ko ;
    rdfs:comment "법령이 개별 조항을 포함한다 / 원천: ABSTRACT_CLEAN / 검증: 조문 매칭"@ko ;
    rdfs:domain rep:LegalInstrument ;
    rdfs:range rep:LegalProvision ;
    owl:inverseOf rep:provisionOf .

rep:hasSection a owl:ObjectProperty ;
    rdfs:label "문서 절 포함"@ko ;
    rdfs:comment "문서가 해당 절·항목을 포함한다 / 원천: ABSTRACT_CLEAN / 검증: 본문 구조 추출"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:DocumentSection ;
    owl:inverseOf rep:sectionOf .

rep:measureOf a owl:ObjectProperty ;
    rdfs:label "소속 상위 정책"@ko ;
    rdfs:comment "세부정책이 소속되는 상위 대책·계획 / 원천: ABSTRACT_CLEAN / 검증: 계층 문장 확인"@ko ;
    rdfs:domain rep:PolicyMeasure ;
    rdfs:range rep:PolicyInitiative ;
    owl:inverseOf rep:hasMeasure .

rep:provisionOf a owl:ObjectProperty ;
    rdfs:label "법령 소속 조항"@ko ;
    rdfs:comment "조항이 특정 법령에 속한다 / 원천: ABSTRACT_CLEAN / 검증: 조문 매칭"@ko ;
    rdfs:domain rep:LegalProvision ;
    rdfs:range rep:LegalInstrument ;
    owl:inverseOf rep:hasProvision .

rep:reportedIn a owl:ObjectProperty ;
    rdfs:label "서술 문서"@ko ;
    rdfs:comment "정책·법령 사건이 기록된 문서 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 검증: 문구 확인"@ko ;
    rdfs:domain rep:ChangeEvent ;
    rdfs:range rep:SourceDocument ;
    owl:inverseOf rep:reportsEvent .

rep:reportsEvent a owl:ObjectProperty ;
    rdfs:label "사건을 서술"@ko ;
    rdfs:comment "문서에서 정책·법령 변경 사건을 보고한다 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 검증: 사건 추출"@ko ;
    rdfs:domain rep:SourceDocument ;
    rdfs:range rep:ChangeEvent ;
    owl:inverseOf rep:reportedIn .

rep:sectionOf a owl:ObjectProperty ;
    rdfs:label "소속 문서"@ko ;
    rdfs:comment "절·항목이 특정 문서에 속한다 / 원천: ABSTRACT_CLEAN / 검증: 본문 구조 추출"@ko ;
    rdfs:domain rep:DocumentSection ;
    rdfs:range rep:SourceDocument ;
    owl:inverseOf rep:hasSection .

rep:versionOfLaw a owl:ObjectProperty ;
    rdfs:label "법령 버전 소속"@ko ;
    rdfs:comment "법령 버전의 원 소속 법령 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 법령 식별자 확인"@ko ;
    rdfs:domain rep:LegalVersion ;
    rdfs:range rep:LegalInstrument ;
    owl:inverseOf rep:hasLegalVersion .

rep:versionOfPolicy a owl:ObjectProperty ;
    rdfs:label "정책 버전 소속"@ko ;
    rdfs:comment "버전이 대응하는 정책 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 검증: 개체 일치 확인"@ko ;
    rdfs:domain rep:PolicyVersion ;
    rdfs:range rep:Policy ;
    owl:inverseOf rep:hasPolicyVersion .

rep:GeographicArea a owl:Class ;
    rdfs:label "적용 지역"@ko ;
    rdfs:comment "정책이 적용되는 행정·지리적 공간 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 역사적 행정구역 명칭을 보존한다"@ko .

rep:HousingType a owl:Class ;
    rdfs:label "주택 유형"@ko ;
    rdfs:comment "공공주택·민영주택·아파트·임대주택 등 유형 / 원천: ABSTRACT_CLEAN / 주의: 주택 유형과 정책수단을 혼동하지 않는다"@ko .

rep:PolicyGoal a owl:Class ;
    rdfs:label "정책목표"@ko ;
    rdfs:comment "정책으로 달성하려는 규범적 목표 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 정량 목표는 QuantitativeTarget으로 분리"@ko .

rep:PolicyInstrument a owl:Class ;
    rdfs:label "정책수단"@ko ;
    rdfs:comment "대출·보증·세금·금융규제·공급 등 집행 방식 / 원천: ABSTRACT_CLEAN / 주의: 조치의 이름과 수단 유형을 구분한다"@ko .

rep:PolicyPlan a owl:Class ;
    rdfs:label "정책 계획"@ko ;
    rdfs:comment "기간·목표·추진전략을 담은 정책계획 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 주의: 수정계획과 기존 계획은 별도 연결한다"@ko ;
    rdfs:subClassOf rep:PolicyInitiative .

rep:PolicyTopic a owl:Class ;
    rdfs:label "정책분야"@ko ;
    rdfs:comment "공급·금융·세제·임대차·정비사업 등 주제 분류 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN / 주의: 주제 분류와 법적 효력은 무관하다"@ko .

rep:TargetGroup a owl:Class ;
    rdfs:label "정책 대상 집단"@ko ;
    rdfs:comment "무주택자·임차인·청년·다주택자 등 대상 / 원천: ABSTRACT_CLEAN / 주의: 문구가 명시한 대상인지 추론인지 기록한다"@ko .

rep:LegalProvision a owl:Class ;
    rdfs:label "법령 조항"@ko ;
    rdfs:comment "법령의 조·항·호·목 등 규범 단위 / 원천: ABSTRACT_CLEAN / 주의: 법령 특정 버전과 조항 번호를 함께 확인한다"@ko ;
    rdfs:subClassOf rep:LegalNorm .

rep:EligibilityRule a owl:Class ;
    rdfs:label "지원·규제 조건"@ko ;
    rdfs:comment "적용·수혜 조건과 문턱값을 특정 버전에 묶은 단위 / 원천: ABSTRACT_CLEAN / 주의: 변경 전후 조건을 시점별로 분리한다"@ko .

rep:LegalInstrument a owl:Class ;
    rdfs:label "법령·행정규범"@ko ;
    rdfs:comment "법률·시행령·훈령·고시 등 규범 문서 / 원천: TITLE_CLEAN·ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 정식 법령 식별자는 외부 대조 필요"@ko ;
    rdfs:subClassOf rep:LegalNorm .

rep:Organization a owl:Class ;
    rdfs:label "기관"@ko ;
    rdfs:comment "정책 발표·집행·법률 공포에 참여한 기관 / 원천: PUBLISHER·POLICY_CONTEXT_CLEAN / 주의: PUBLISHER 문자열에 실·과 단위가 함께 포함될 수 있다"@ko .

rep:QuantitativeTarget a owl:Class ;
    rdfs:label "정량 목표"@ko ;
    rdfs:comment "공급 호수·비율·금액처럼 측정 가능한 목표치 / 원천: ABSTRACT_CLEAN·POLICY_CONTEXT_CLEAN / 주의: 계획치와 실적치를 구분한다"@ko .

rep:DocumentSection a owl:Class ;
